TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-a-turso-database-token

# Vercel AI SDK agent runtime (Amazon Bedrock account 760561616756)
OPSSEMBLE_AI_PROVIDER=amazon-bedrock
OPSSEMBLE_AI_MODEL=openai.gpt-5.6-terra
OPSSEMBLE_BEDROCK_REGION=us-east-2
OPSSEMBLE_BEDROCK_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/openai/v1
AWS_PROFILE=codex-fable

# Generate a local-only bearer token with: openssl rand -hex 32
OPSSEMBLE_AGENT_LOCAL_TOKEN=replace-with-at-least-32-random-characters
OPSSEMBLE_AGENT_MAX_STEPS=8
OPSSEMBLE_AGENT_MAX_TOOL_CALLS=16
OPSSEMBLE_AGENT_TIMEOUT_MS=45000
OPSSEMBLE_AGENT_MAX_OUTPUT_TOKENS=2048
OPSSEMBLE_AGENT_MAX_RETRIES=1

# Fake monitoring/MCP service
FLIGHTLAB_BASE_URL=https://flightlab.example.com
GITHUB_REPOSITORY=Prathamesh-Pawar/flylab
GITHUB_TOKEN=replace-with-a-github-token
GITHUB_WEBHOOK_SECRET=replace-with-a-github-webhook-secret
OPSSEMBLE_INGEST_SECRET=replace-with-a-distinct-ingress-secret
MCP_TOKEN=replace-with-an-mcp-bearer-token
REPLAY_SPEED=1
SESSION_TTL_SECONDS=7200
MAX_SESSIONS=100

# Agent access to the read-only MCP observation profile
OPSSEMBLE_FAKE_MCP_URL=http://127.0.0.1:8000/mcp/agent/
OPSSEMBLE_FAKE_MCP_TOKEN=replace-with-the-same-mcp-bearer-token
