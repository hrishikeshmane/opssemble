@@ -0,0 +1,51 @@
+import { randomUUID } from "node:crypto";
+import { completeDemoBooking, type BookingInput } from "@/lib/booking";
+
+export class ProviderUnavailable extends Error {}
+export class ProviderResponseTimeout extends Error {}
+
+export type ProviderFailure = "none" | "before-commit" | "after-commit";
+export type ProviderResult = { reservationId: string; paymentIntentId: string; attemptKey: string };
+
+export class DemoBookingProvider {
+  readonly reservations: ProviderResult[] = [];
+  readonly payments: ProviderResult[] = [];
+  private readonly resultsByAttemptKey = new Map<string, ProviderResult>();
+
+  constructor(private readonly failure: ProviderFailure = "none") {}
+
+  async reserveAndCharge(operationId: string, attemptKey: string): Promise<ProviderResult> {
+    if (this.failure === "before-commit") throw new ProviderUnavailable("provider unavailable before commit");
+    const existing = this.resultsByAttemptKey.get(attemptKey);
+    if (existing) return existing;
+
+    const suffix = this.reservations.length === 0 ? "a" : "b";
+    const result = {
+      reservationId: `res-${operationId.replace("op-", "")}-${suffix}`,
+      paymentIntentId: `pi-${operationId.replace("op-", "")}-${suffix}`,
+      attemptKey,
+    };
+    this.resultsByAttemptKey.set(attemptKey, result);
+    this.reservations.push(result);
+    this.payments.push(result);
+    if (this.failure === "after-commit") {
+      throw new ProviderResponseTimeout("provider response timed out after commit");
+    }
+    return result;
+  }
+}
+
+export async function bookWithTimeoutRetry(
+  input: BookingInput,
+  provider: DemoBookingProvider,
+  createAttemptKey: () => string = randomUUID,
+): Promise<ProviderResult> {
+  const booking = completeDemoBooking(input);
+  try {
+    return await provider.reserveAndCharge(booking.operationId, createAttemptKey());
+  } catch (error) {
+    if (!(error instanceof ProviderResponseTimeout)) throw error;
+    // A response timeout is ambiguous, but this retry incorrectly starts a new idempotency scope.
+    return provider.reserveAndCharge(booking.operationId, createAttemptKey());
+  }
+}
