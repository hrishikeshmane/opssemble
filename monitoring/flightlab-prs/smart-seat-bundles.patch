+++ b/tests/seat-scoring-api.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it, vi } from "vitest";
+import { POST } from "@/app/api/seat-scores/route";
+import { scoreSeatBundles } from "@/lib/seat-scoring";
+
+describe("smart seat bundle scoring", () => {
+  it("ranks independently scored bundles and honors a preferred bundle", async () => {
+    const score = vi.fn(async (bundle: { id: string }) => ({ standard: 10, "extra-legroom": 20, flex: 15 }[bundle.id] ?? 0));
+    const bundles = await scoreSeatBundles("extra-legroom", score);
+
+    expect(bundles.map((bundle) => bundle.id)).toEqual(["extra-legroom", "flex", "standard"]);
+    expect(score).toHaveBeenCalledTimes(3);
+  });
+
+  it("serves scored bundles through the server-owned API", async () => {
+    const response = await POST(new Request("http://flightlab.test/api/seat-scores", {
+      method: "POST",
+      headers: { "content-type": "application/json", "x-request-id": "req-seat-1" },
+      body: JSON.stringify({ flightId: "FL-204", preferredBundleId: "extra-legroom" }),
+    }));
+
+    expect(response.status).toBe(200);
+    const body = await response.json();
+    expect(body.flightId).toBe("FL-204");
+    expect(body.bundles.map((bundle: { id: string }) => bundle.id)).toEqual(["extra-legroom", "flex", "standard"]);
+  });
+});

